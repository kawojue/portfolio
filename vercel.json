{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "tanstack-start",
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.kawojue.dev" }],
            "destination": "https://kawojue.dev/:path*",
            "permanent": true
        }
    ]
}
